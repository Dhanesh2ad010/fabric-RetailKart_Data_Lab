// KQL script
// Use management commands in this script to configure your database items, such as tables, functions, materialized views, and more.


.create-merge table Stocks (Date:datetime, Open:real, High:real, Low:real, Close:real, AdjClose:real, Volume:string, Ticker:string) 
.create-merge table StocksDaily (Ticker:string, Date:datetime, Range:real) 
.create-merge table bike_agg2 (AVG_No_Bikes:real, BikepointID:string, Street:string, Neighbourhood:string, Latitude:real, Longitude:real, No_Bikes:long, No_Empty_Docks:long) 
.create-or-alter function with (skipvalidation = "true") StocksDailyTransform() {
    Stocks | project Ticker, Date, Range = High - Low
}
.create-or-alter materialized-view  StocksLatest on table Stocks { Stocks | summarize arg_max(Date, *) by Ticker }
.alter table Stocks policy caching hotdata = time(30.00:00:00) hotindex = time(30.00:00:00)
.alter table StocksDaily policy update "[{\"IsEnabled\":true,\"Source\":\"Stocks\",\"Query\":\"StocksDailyTransform()\",\"IsTransactional\":false,\"PropagateIngestionProperties\":false,\"ManagedIdentity\":null,\"IsAsync\":false}]"
